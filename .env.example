# Copy to .env and fill in. The app runs on DEMO data with no provider keys — add a key
# to flip that connector to LIVE.

# ── LLM reasoning layer (at least one recommended; failover in this order) ──
GROQ_API_KEY=            # console.groq.com  (fast, strong)
GEMINI_API_KEY=          # aistudio.google.com/apikey  (overflow)
OLLAMA_ENABLED=false     # true = local model as free safety-net failover
OLLAMA_MODEL=qwen2.5:7b

# ── Real data providers (structured APIs — not scraping) ──
AMADEUS_CLIENT_ID=       # developers.amadeus.com  (free tier flights)
AMADEUS_CLIENT_SECRET=
SERPAPI_KEY=             # serpapi.com  (Google Shopping product data)

# ── Infra ──
REDIS_URL=               # blank = in-process cache; e.g. redis://localhost:6379
CACHE_TTL_SECONDS=300
SOURCE_TIMEOUT_SECONDS=8
